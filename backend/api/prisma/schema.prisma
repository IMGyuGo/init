generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  ADMIN
  COMPANY
  CANDIDATE
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DEACTIVATED
}

enum PostingStatus {
  DRAFT
  OPEN
  CLOSING_SOON
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  INTERVIEW_WAITING
  INTERVIEW_DONE
  COMPLETED
  CANCELED
}

enum DocumentStatus {
  NOT_SUBMITTED
  SUBMITTED
  EXTRACTING
  EXTRACTED
  FAILED
}

enum InterviewStatus {
  NOT_READY
  READY
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ReportStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
}

enum ScreeningDecision {
  UNDECIDED
  PASS
  HOLD
  FAIL
}

enum InterviewType {
  MOCK
  RECRUITING
}

enum ReportType {
  MOCK_INTERVIEW_REPORT
  RECRUITING_REPORT
}

enum DocumentType {
  RESUME
  PORTFOLIO
}

enum ConsentType {
  PRIVACY_COLLECTION
  AI_DOCUMENT_ANALYSIS
  AI_INTERVIEW_RECORDING
}

enum QuestionType {
  INTRO
  TECHNICAL
  EXPERIENCE
  SITUATION
  FOLLOW_UP
  CLOSING
}

enum QuestionOrigin {
  MANUAL
  AI_GENERATED
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum AiProcessType {
  DOCUMENT_EXTRACT
  STT
  FOLLOW_UP
  REPORT_GENERATE
  EMBEDDING
  GUARDRAIL_VALIDATE
  CRITERIA_SUGGEST
  QUESTION_GENERATE
  QUESTION_SET_GENERATE
  POSTING_DRAFT_GENERATE
}

enum AiProcessStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum GuardrailResult {
  PASS
  BLOCKED
  REGENERATED
}

enum EmbeddingSourceType {
  POSTING_JD
  CRITERION_TAG
  QUESTION
  APPLICATION_DOCUMENT
  INTERVIEW_ANSWER
  EVALUATION_REPORT
}

model User {
  userId            BigInt             @id @default(autoincrement()) @map("user_id")
  email             String             @unique @db.VarChar(255)
  passwordHash      String?            @map("password_hash") @db.VarChar(255)
  userType          UserType           @map("user_type")
  name              String             @db.VarChar(100)
  phone             String?            @db.VarChar(50)
  status            UserStatus         @default(PENDING)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  authProvider      AuthProvider       @default(LOCAL) @map("auth_provider")
  providerUserId    String?            @map("provider_user_id") @db.VarChar(255)
  ownedCompany      Company?           @relation("CompanyOwner")
  candidateProfile  CandidateProfile?
  fileAssets        FileAsset[]
  manualEvaluations ManualEvaluation[]
  notifications     Notification[]
  paymentCustomers  PaymentCustomer[]

  @@unique([authProvider, providerUserId], map: "uk_users_provider_user")
  @@map("users")
}

model Company {
  companyId                  BigInt     @id @default(autoincrement()) @map("company_id")
  ownerUserId                BigInt     @unique @map("owner_user_id")
  name                       String     @db.VarChar(150)
  businessRegistrationNumber String     @unique @map("business_registration_number") @db.VarChar(10)
  verificationStatus         String     @map("verification_status") @db.VarChar(30)
  logoFileId                 BigInt?    @map("logo_file_id")
  industry                   String?    @db.VarChar(100)
  profile                    String?
  talentProfile              String?    @map("talent_profile")
  evaluationPolicy           String?    @map("evaluation_policy")
  createdAt                  DateTime   @default(now()) @map("created_at")
  updatedAt                  DateTime   @updatedAt @map("updated_at")
  owner                      User       @relation("CompanyOwner", fields: [ownerUserId], references: [userId])
  logoFile                   FileAsset? @relation("CompanyLogo", fields: [logoFileId], references: [fileId])
  postings                   Posting[]
  questions                  Question[]
  paymentCustomers           PaymentCustomer[]
  paymentOrders              PaymentOrder[]

  @@map("companies")
}

model FileAsset {
  fileId            BigInt                @id @default(autoincrement()) @map("file_id")
  ownerUserId       BigInt                @map("owner_user_id")
  storageKey        String                @map("storage_key") @db.VarChar(500)
  originalName      String                @map("original_name") @db.VarChar(255)
  mimeType          String                @map("mime_type") @db.VarChar(100)
  sizeBytes         BigInt                @map("size_bytes")
  status            String                @db.VarChar(30)
  createdAt         DateTime              @default(now()) @map("created_at")
  owner             User                  @relation(fields: [ownerUserId], references: [userId])
  companyLogos      Company[]             @relation("CompanyLogo")
  candidateProfiles CandidateProfile[]
  candidateFolders  CandidateFolder[]      @relation("CandidateFolderResume")
  documents         ApplicationDocument[]
  videoAnswers      InterviewAnswer[]     @relation("VideoFile")
  audioAnswers      InterviewAnswer[]     @relation("AudioFile")

  @@map("file_assets")
}

model CandidateProfile {
  candidateId         BigInt             @id @default(autoincrement()) @map("candidate_id")
  userId              BigInt             @unique @map("user_id")
  defaultResumeFileId BigInt?            @map("default_resume_file_id")
  portfolioUrl        String?            @map("portfolio_url") @db.VarChar(500)
  githubUrl           String?            @map("github_url") @db.VarChar(500)
  summary             String?
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  user                User               @relation(fields: [userId], references: [userId])
  defaultResumeFile   FileAsset?         @relation(fields: [defaultResumeFileId], references: [fileId])
  applications        Application[]
  interviewSessions   InterviewSession[]
  candidateFolders     CandidateFolder[]
  mockPassLedgers     CandidateMockInterviewPassLedger[]
  paymentCustomers    PaymentCustomer[]
  paymentOrders       PaymentOrder[]

  @@map("candidate_profiles")
}

model CandidateFolder {
  id            BigInt           @id @default(autoincrement())
  candidateId   BigInt           @map("candidate_id")
  name          String           @db.VarChar(100)
  githubUrl     String?          @map("github_url") @db.VarChar(500)
  blogUrl       String?          @map("blog_url") @db.VarChar(500)
  portfolioUrl  String?          @map("portfolio_url") @db.VarChar(500)
  resumeFileId  BigInt?          @map("resume_file_id")
  motivation    String?
  extraNote     String?          @map("extra_note")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  candidate     CandidateProfile @relation(fields: [candidateId], references: [candidateId], onDelete: Cascade)
  resumeFile    FileAsset?       @relation("CandidateFolderResume", fields: [resumeFileId], references: [fileId], onDelete: SetNull)

  @@index([candidateId], map: "idx_candidate_folders_candidate_id")
  @@map("candidate_folders")
}

model Posting {
  postingId            BigInt                 @id @default(autoincrement()) @map("posting_id")
  companyId            BigInt                 @map("company_id")
  title                String                 @db.VarChar(200)
  jobRole              String                 @map("job_role") @db.VarChar(100)
  jobDescription       String?                @map("job_description")
  careerRequirement    String?                @map("career_requirement") @db.VarChar(150)
  educationRequirement String?                @map("education_requirement") @db.VarChar(150)
  salaryInfo           String?                @map("salary_info") @db.VarChar(150)
  workLocation         String?                @map("work_location") @db.VarChar(150)
  employmentType       String?                @map("employment_type") @db.VarChar(150)
  // 지원자 필터용 구조화 필드(한글 라벨 코드). 값 검증은 애플리케이션단(IsIn)에서 수행.
  jobRoleCode          String?                @map("job_role_code") @db.VarChar(50)
  regionCode           String?                @map("region_code") @db.VarChar(30)
  careerMinYears       Int?                   @map("career_min_years")
  careerMaxYears       Int?                   @map("career_max_years")
  employmentTypeCode   String?                @map("employment_type_code") @db.VarChar(20)
  recruitmentType      String?                @map("recruitment_type") @db.VarChar(20)
  // 회사 위치: 도로명 주소 + 위경도(지원자 공고 상세 지도 핀용). 좌표는 프론트 geocoder 로 채워 저장.
  workplaceAddress     String?                @map("workplace_address") @db.VarChar(300)
  workplaceLat         Float?                 @map("workplace_lat")
  workplaceLng         Float?                 @map("workplace_lng")
  startsOn             DateTime?              @map("starts_on") @db.Date
  endsOn               DateTime?              @map("ends_on") @db.Date
  status               PostingStatus          @default(DRAFT)
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  company              Company                @relation(fields: [companyId], references: [companyId])
  criteria             EvaluationCriterion[]
  questions            Question[]
  applications         Application[]
  questionSets         InterviewQuestionSet[]
  timePolicy           InterviewTimePolicy?

  @@index([companyId, status])
  @@map("postings")
}

model CriterionTag {
  tagId       BigInt                @id @default(autoincrement()) @map("tag_id")
  jobRole     String                @map("job_role") @db.VarChar(100)
  name        String                @db.VarChar(100)
  description String?
  category    String                @db.VarChar(80)
  isActive    Boolean               @default(true) @map("is_active")
  sortOrder   Int                   @map("sort_order")
  criteria    EvaluationCriterion[]

  @@map("criterion_tags")
}

model EvaluationCriterion {
  criterionId      BigInt                     @id @default(autoincrement()) @map("criterion_id")
  postingId        BigInt                     @map("posting_id")
  tagId            BigInt                     @map("tag_id")
  description      String?
  weight           Int
  passScore        Int?                       @map("pass_score")
  sortOrder        Int                        @map("sort_order")
  posting          Posting                    @relation(fields: [postingId], references: [postingId])
  tag              CriterionTag               @relation(fields: [tagId], references: [tagId])
  questions        Question[]
  reportScores     ReportScore[]
  questionSetItems InterviewQuestionSetItem[]

  @@map("evaluation_criteria")
}

model Question {
  questionId       BigInt                     @id @default(autoincrement()) @map("question_id")
  companyId        BigInt                     @map("company_id")
  postingId        BigInt?                    @map("posting_id")
  criterionId      BigInt?                    @map("criterion_id")
  questionType     QuestionType               @map("question_type")
  content          String
  origin           QuestionOrigin             @default(MANUAL)
  isAiEdited       Boolean                    @default(false) @map("is_ai_edited")
  isActive         Boolean                    @default(true) @map("is_active")
  company          Company                    @relation(fields: [companyId], references: [companyId])
  posting          Posting?                   @relation(fields: [postingId], references: [postingId])
  criterion        EvaluationCriterion?       @relation(fields: [criterionId], references: [criterionId])
  answers          InterviewAnswer[]
  questionSetItems InterviewQuestionSetItem[]
  sessionQuestions InterviewSessionQuestion[]

  @@map("question_bank")
}

model InterviewQuestionSet {
  questionSetId         BigInt                     @id @default(autoincrement()) @map("question_set_id")
  postingId             BigInt                     @map("posting_id")
  title                 String                     @db.VarChar(200)
  status                String                     @default("DRAFT") @db.VarChar(30)
  createdByProcessLogId BigInt?                    @map("created_by_process_log_id")
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")
  posting               Posting                    @relation(fields: [postingId], references: [postingId])
  createdByProcessLog   AiProcessLog?              @relation(fields: [createdByProcessLogId], references: [processLogId])
  items                 InterviewQuestionSetItem[]

  @@index([postingId, status], map: "idx_interview_question_sets_posting_status")
  @@map("interview_question_sets")
}

model InterviewQuestionSetItem {
  questionSetItemId BigInt               @id @default(autoincrement()) @map("question_set_item_id")
  questionSetId     BigInt               @map("question_set_id")
  questionId        BigInt               @map("question_id")
  criterionId       BigInt?              @map("criterion_id")
  sortOrder         Int                  @map("sort_order")
  questionSet       InterviewQuestionSet @relation(fields: [questionSetId], references: [questionSetId])
  question          Question             @relation(fields: [questionId], references: [questionId])
  criterion         EvaluationCriterion? @relation(fields: [criterionId], references: [criterionId])

  @@unique([questionSetId, sortOrder], map: "uq_interview_question_set_items_order")
  @@map("interview_question_set_items")
}

model InterviewTimePolicy {
  postingId          BigInt   @id @map("posting_id")
  preparationTimeSec Int      @default(0) @map("preparation_time_sec")
  answerTimeSec      Int      @default(90) @map("answer_time_sec")
  retryAllowed       Boolean  @default(false) @map("retry_allowed")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  posting            Posting  @relation(fields: [postingId], references: [postingId], onDelete: Cascade)

  @@map("interview_time_policies")
}

model Application {
  applicationId         BigInt                 @id @default(autoincrement()) @map("application_id")
  postingId             BigInt                 @map("posting_id")
  candidateId           BigInt                 @map("candidate_id")
  applicantName         String?                @map("applicant_name") @db.VarChar(100)
  applicantEmail        String?                @map("applicant_email") @db.VarChar(255)
  applicantPhone        String?                @map("applicant_phone") @db.VarChar(50)
  githubUrl             String?                @map("github_url") @db.VarChar(500)
  blogUrl               String?                @map("blog_url") @db.VarChar(500)
  portfolioUrl          String?                @map("portfolio_url") @db.VarChar(500)
  motivation            String?
  additionalInfo        String?                @map("additional_info")
  applicationStatus     ApplicationStatus      @default(SUBMITTED) @map("application_status")
  documentStatus        DocumentStatus         @default(NOT_SUBMITTED) @map("document_status")
  interviewStatus       InterviewStatus        @default(NOT_READY) @map("interview_status")
  reportStatus          ReportStatus           @default(PENDING) @map("report_status")
  screeningDecision     ScreeningDecision?     @default(UNDECIDED) @map("screening_decision")
  screeningMemo         String?                @map("screening_memo")
  submittedAt           DateTime?              @map("submitted_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  posting               Posting                @relation(fields: [postingId], references: [postingId])
  candidate             CandidateProfile       @relation(fields: [candidateId], references: [candidateId])
  documents             ApplicationDocument[]
  consentRecords        ConsentRecord[]
  interviewSessions     InterviewSession[]
  evaluationReports     EvaluationReport[]
  notifications         Notification[]
  aiProcessLogs         AiProcessLog[]
  clientPerformanceLogs ClientPerformanceLog[]

  @@unique([postingId, candidateId])
  @@index([postingId, applicationStatus])
  @@map("applications")
}

model ApplicationDocument {
  documentId    BigInt         @id @default(autoincrement()) @map("document_id")
  applicationId BigInt         @map("application_id")
  fileId        BigInt?        @map("file_id")
  documentType  DocumentType   @map("document_type")
  parseStatus   DocumentStatus @map("parse_status")
  extractedText String?        @map("extracted_text")
  uploadedAt    DateTime       @default(now()) @map("uploaded_at")
  application   Application    @relation(fields: [applicationId], references: [applicationId])
  file          FileAsset?     @relation(fields: [fileId], references: [fileId])

  @@map("application_documents")
}

model ConsentRecord {
  consentId     BigInt      @id @default(autoincrement()) @map("consent_id")
  applicationId BigInt      @map("application_id")
  consentType   ConsentType @map("consent_type")
  agreed        Boolean
  agreedAt      DateTime?   @map("agreed_at")
  application   Application @relation(fields: [applicationId], references: [applicationId])

  @@map("consent_records")
}

model InterviewSession {
  sessionId             BigInt                             @id @default(autoincrement()) @map("session_id")
  applicationId         BigInt?                            @map("application_id")
  candidateId           BigInt                             @map("candidate_id")
  interviewType         InterviewType                      @map("interview_type")
  title                 String?                            @db.VarChar(100)
  status                InterviewStatus                    @default(NOT_READY)
  showQuestionText      Boolean                            @default(false) @map("show_question_text")
  startedAt             DateTime?                          @map("started_at")
  completedAt           DateTime?                          @map("completed_at")
  application           Application?                       @relation(fields: [applicationId], references: [applicationId])
  candidate             CandidateProfile                   @relation(fields: [candidateId], references: [candidateId])
  answers               InterviewAnswer[]
  sessionQuestions      InterviewSessionQuestion[]
  evaluationReports     EvaluationReport[]
  aiProcessLogs         AiProcessLog[]
  clientPerformanceLogs ClientPerformanceLog[]
  mockPassUsages        CandidateMockInterviewPassLedger[]

  @@map("interview_sessions")
}

model InterviewSessionQuestion {
  sessionQuestionId BigInt            @id @default(autoincrement()) @map("session_question_id")
  sessionId         BigInt            @map("session_id")
  questionId        BigInt?           @map("question_id")
  runtimeQuestionId BigInt?           @unique(map: "uq_interview_session_questions_runtime_question") @map("runtime_question_id")
  questionType      QuestionType?     @map("question_type")
  content           String?
  sortOrder         Int               @map("sort_order")
  createdAt         DateTime          @default(now()) @map("created_at")
  session           InterviewSession  @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  question          Question?         @relation(fields: [questionId], references: [questionId], onDelete: Restrict)
  answers           InterviewAnswer[]

  @@unique([sessionId, questionId], map: "uq_interview_session_questions_question")
  @@unique([sessionId, sortOrder], map: "uq_interview_session_questions_order")
  @@index([questionId], map: "idx_interview_session_questions_question")
  @@map("interview_session_questions")
}

model CandidateMockInterviewPassLedger {
  ledgerId       BigInt            @id @default(autoincrement()) @map("ledger_id")
  candidateId    BigInt            @map("candidate_id")
  paymentOrderId BigInt?           @map("payment_order_id")
  usedSessionId  BigInt?           @map("used_session_id")
  source         String            @db.VarChar(40)
  changeAmount   Int               @map("change_amount")
  expiresAt      DateTime?         @map("expires_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  candidate      CandidateProfile  @relation(fields: [candidateId], references: [candidateId])
  paymentOrder   PaymentOrder?     @relation(fields: [paymentOrderId], references: [paymentOrderId])
  usedSession    InterviewSession? @relation(fields: [usedSessionId], references: [sessionId])

  @@index([candidateId, createdAt], map: "idx_candidate_mock_pass_candidate_created")
  @@index([candidateId, expiresAt], map: "idx_candidate_mock_pass_candidate_expires")
  @@unique([paymentOrderId], map: "uk_candidate_mock_pass_payment_order")
  @@map("candidate_mock_interview_pass_ledgers")
}

model InterviewAnswer {
  answerId          BigInt             @id @default(autoincrement()) @map("answer_id")
  sessionId         BigInt             @map("session_id")
  questionId        BigInt?            @map("question_id")
  sessionQuestionId BigInt?            @map("session_question_id")
  videoFileId       BigInt?            @map("video_file_id")
  audioFileId       BigInt?            @map("audio_file_id")
  transcript        String?
  nonverbalMetadata Json?              @map("nonverbal_metadata")
  durationSeconds   Int?               @map("duration_seconds")
  submittedAt       DateTime?          @map("submitted_at")
  session           InterviewSession   @relation(fields: [sessionId], references: [sessionId])
  question          Question?          @relation(fields: [questionId], references: [questionId])
  sessionQuestion   InterviewSessionQuestion? @relation(fields: [sessionQuestionId], references: [sessionQuestionId], onDelete: SetNull)
  videoFile         FileAsset?         @relation("VideoFile", fields: [videoFileId], references: [fileId])
  audioFile         FileAsset?         @relation("AudioFile", fields: [audioFileId], references: [fileId])
  followUpQuestions FollowUpQuestion[]
  reportEvidences   ReportEvidence[]

  @@index([sessionQuestionId], map: "idx_interview_answers_session_question")
  @@map("interview_answers")
}

model FollowUpQuestion {
  followUpId       BigInt          @id @default(autoincrement()) @map("follow_up_id")
  answerId         BigInt          @map("answer_id")
  content          String
  generationStatus String          @map("generation_status") @db.VarChar(40)
  policy           String          @default("RECRUITING") @db.VarChar(40)
  createdAt        DateTime        @default(now()) @map("created_at")
  answer           InterviewAnswer @relation(fields: [answerId], references: [answerId])

  @@unique([answerId, policy], name: "answerIdPolicy", map: "uq_follow_up_questions_answer_policy")
  @@map("follow_up_questions")
}

model EvaluationReport {
  reportId          BigInt             @id @default(autoincrement()) @map("report_id")
  applicationId     BigInt?            @map("application_id")
  sessionId         BigInt?            @map("session_id")
  reportType        ReportType         @map("report_type")
  status            ReportStatus       @default(PENDING)
  totalScore        Int?               @map("total_score")
  summary           String?
  generatedAt       DateTime?          @map("generated_at")
  failureCategory   String?            @map("failure_category") @db.VarChar(40)
  failureReason     String?            @map("failure_reason")
  application       Application?       @relation(fields: [applicationId], references: [applicationId])
  session           InterviewSession?  @relation(fields: [sessionId], references: [sessionId])
  scores            ReportScore[]
  manualEvaluations ManualEvaluation[]

  @@map("evaluation_reports")
}

model ReportScore {
  scoreId     BigInt               @id @default(autoincrement()) @map("score_id")
  reportId    BigInt               @map("report_id")
  criterionId BigInt?              @map("criterion_id")
  score       Int
  rationale   String?
  report      EvaluationReport     @relation(fields: [reportId], references: [reportId])
  criterion   EvaluationCriterion? @relation(fields: [criterionId], references: [criterionId])
  evidences   ReportEvidence[]

  @@map("report_scores")
}

model ReportEvidence {
  evidenceId   BigInt           @id @default(autoincrement()) @map("evidence_id")
  scoreId      BigInt           @map("score_id")
  sourceType   String           @default("INTERVIEW_ANSWER") @map("source_type") @db.VarChar(80)
  answerId     BigInt?          @map("answer_id")
  documentId   BigInt?          @map("document_id")
  documentRef  String?          @map("document_ref") @db.VarChar(255)
  evidenceText String           @map("evidence_text")
  score        ReportScore      @relation(fields: [scoreId], references: [scoreId])
  answer       InterviewAnswer? @relation(fields: [answerId], references: [answerId])

  @@map("report_evidences")
}

model ManualEvaluation {
  manualEvalId   BigInt             @id @default(autoincrement()) @map("manual_eval_id")
  reportId       BigInt             @map("report_id")
  reviewerUserId BigInt             @map("reviewer_user_id")
  decision       ScreeningDecision?
  memo           String?
  reviewedAt     DateTime?          @map("reviewed_at")
  report         EvaluationReport   @relation(fields: [reportId], references: [reportId])
  reviewer       User               @relation(fields: [reviewerUserId], references: [userId])

  @@map("manual_evaluations")
}

model Notification {
  notificationId   BigInt              @id @default(autoincrement()) @map("notification_id")
  userId           BigInt              @map("user_id")
  applicationId    BigInt?             @map("application_id")
  channel          NotificationChannel
  notificationType String              @map("notification_type") @db.VarChar(80)
  status           String              @db.VarChar(40)
  sentAt           DateTime?           @map("sent_at")
  user             User                @relation(fields: [userId], references: [userId])
  application      Application?        @relation(fields: [applicationId], references: [applicationId])

  @@map("notifications")
}

model AiProcessLog {
  processLogId          BigInt                 @id @default(autoincrement()) @map("process_log_id")
  applicationId         BigInt?                @map("application_id")
  sessionId             BigInt?                @map("session_id")
  processType           AiProcessType          @map("process_type")
  status                AiProcessStatus        @default(PENDING)
  inputRef              String?                @map("input_ref")
  outputRef             String?                @map("output_ref")
  failureCategory       String?                @map("failure_category") @db.VarChar(40)
  failureReason         String?                @map("failure_reason")
  startedAt             DateTime?              @map("started_at")
  completedAt           DateTime?              @map("completed_at")
  durationMs            Int?                   @map("duration_ms")
  modelName             String?                @map("model_name") @db.VarChar(120)
  inputTokens           Int?                   @map("input_tokens")
  outputTokens          Int?                   @map("output_tokens")
  audioSeconds          Int?                   @map("audio_seconds")
  estimatedCostUsd      Decimal?               @map("estimated_cost_usd") @db.Decimal(12, 6)
  costMetadataJson      String?                @map("cost_metadata_json")
  createdAt             DateTime               @default(now()) @map("created_at")
  application           Application?           @relation(fields: [applicationId], references: [applicationId])
  session               InterviewSession?      @relation(fields: [sessionId], references: [sessionId])
  guardrailLogs         AiGuardrailLog[]
  timingEvents          AiProcessTimingEvent[]
  clientPerformanceLogs ClientPerformanceLog[]
  createdQuestionSets   InterviewQuestionSet[]

  @@map("ai_process_logs")
}

model AiProcessTimingEvent {
  timingEventId BigInt       @id @default(autoincrement()) @map("timing_event_id")
  processLogId  BigInt       @map("process_log_id")
  eventName     String       @map("event_name") @db.VarChar(80)
  startedAt     DateTime?    @map("started_at")
  completedAt   DateTime?    @map("completed_at")
  durationMs    Int?         @map("duration_ms")
  metadataJson  String?      @map("metadata_json")
  createdAt     DateTime     @default(now()) @map("created_at")
  processLog    AiProcessLog @relation(fields: [processLogId], references: [processLogId])

  @@index([processLogId, eventName], map: "idx_ai_process_timing_events_process_event")
  @@index([eventName, createdAt], map: "idx_ai_process_timing_events_event_created")
  @@map("ai_process_timing_events")
}

model ClientPerformanceLog {
  clientPerformanceLogId BigInt            @id @default(autoincrement()) @map("client_performance_log_id")
  eventName              String            @map("event_name") @db.VarChar(80)
  processLogId           BigInt?           @map("process_log_id")
  sessionId              BigInt?           @map("session_id")
  applicationId          BigInt?           @map("application_id")
  questionId             BigInt?           @map("question_id")
  durationMs             Int               @map("duration_ms")
  startedAt              DateTime?         @map("started_at")
  completedAt            DateTime?         @map("completed_at")
  metadataJson           String?           @map("metadata_json")
  createdAt              DateTime          @default(now()) @map("created_at")
  processLog             AiProcessLog?     @relation(fields: [processLogId], references: [processLogId])
  session                InterviewSession? @relation(fields: [sessionId], references: [sessionId])
  application            Application?      @relation(fields: [applicationId], references: [applicationId])

  @@index([eventName, createdAt], map: "idx_client_performance_logs_event_created")
  @@index([sessionId, eventName], map: "idx_client_performance_logs_session_event")
  @@index([processLogId], map: "idx_client_performance_logs_process_log")
  @@map("client_performance_logs")
}

model AiGuardrailLog {
  guardrailLogId  BigInt          @id @default(autoincrement()) @map("guardrail_log_id")
  processLogId    BigInt          @map("process_log_id")
  policyName      String          @map("policy_name") @db.VarChar(120)
  result          GuardrailResult
  reason          String?
  failureCategory String?         @map("failure_category") @db.VarChar(40)
  createdAt       DateTime        @default(now()) @map("created_at")
  processLog      AiProcessLog    @relation(fields: [processLogId], references: [processLogId])

  @@map("ai_guardrail_logs")
}

model Embedding {
  embeddingId        BigInt              @id @default(autoincrement()) @map("embedding_id")
  postingId          BigInt?             @map("posting_id")
  tagId              BigInt?             @map("tag_id")
  questionId         BigInt?             @map("question_id")
  documentId         BigInt?             @map("document_id")
  answerId           BigInt?             @map("answer_id")
  reportId           BigInt?             @map("report_id")
  sourceType         EmbeddingSourceType @map("source_type")
  sourceTextHash     String              @map("source_text_hash") @db.VarChar(128)
  embeddingModel     String              @map("embedding_model") @db.VarChar(120)
  embeddingDimension Int                 @map("embedding_dimension")
  embeddingVector    String              @map("embedding_vector")
  metadataJson       String?             @map("metadata_json")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@unique([sourceType, sourceTextHash], name: "sourceTypeSourceTextHash")
  @@index([sourceType], map: "idx_embeddings_source_type")
  @@index([sourceTextHash], map: "idx_embeddings_source_hash")
  @@map("embeddings")
}

model PaymentCustomer {
  paymentCustomerId BigInt         @id @default(autoincrement()) @map("payment_customer_id")
  userId            BigInt         @map("user_id")
  companyId         BigInt?        @map("company_id")
  candidateId       BigInt?        @map("candidate_id")
  provider          String         @db.VarChar(30)
  customerKey       String         @map("customer_key") @db.VarChar(100)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  user              User           @relation(fields: [userId], references: [userId])
  company           Company?       @relation(fields: [companyId], references: [companyId])
  candidate         CandidateProfile? @relation(fields: [candidateId], references: [candidateId])
  orders            PaymentOrder[]

  @@unique([provider, customerKey], map: "uk_payment_customers_provider_customer_key")
  @@unique([provider, companyId], map: "uk_payment_customers_provider_company")
  @@unique([provider, candidateId], map: "uk_payment_customers_provider_candidate")
  @@map("payment_customers")
}

model PaymentOrder {
  paymentOrderId   BigInt          @id @default(autoincrement()) @map("payment_order_id")
  paymentCustomerId BigInt         @map("payment_customer_id")
  companyId        BigInt?         @map("company_id")
  candidateId      BigInt?         @map("candidate_id")
  provider         String          @db.VarChar(30)
  orderId          String          @map("order_id") @db.VarChar(100)
  paymentKey       String?         @map("payment_key") @db.VarChar(200)
  productCode      String          @map("product_code") @db.VarChar(50)
  orderName        String          @map("order_name") @db.VarChar(150)
  type             String          @db.VarChar(30)
  status           String          @db.VarChar(30)
  amount           Int
  currency         String          @db.VarChar(3)
  method           String?         @db.VarChar(30)
  receiptUrl       String?         @map("receipt_url")
  failureCode      String?         @map("failure_code") @db.VarChar(100)
  failureMessage   String?         @map("failure_message")
  providerPayload  Json?           @map("provider_payload")
  requestedAt      DateTime?       @map("requested_at")
  approvedAt       DateTime?       @map("approved_at")
  failedAt         DateTime?       @map("failed_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  paymentCustomer  PaymentCustomer @relation(fields: [paymentCustomerId], references: [paymentCustomerId])
  company          Company?        @relation(fields: [companyId], references: [companyId])
  candidate        CandidateProfile? @relation(fields: [candidateId], references: [candidateId])
  mockPassLedgers  CandidateMockInterviewPassLedger[]

  @@unique([provider, orderId], map: "uk_payment_orders_provider_order")
  @@unique([provider, paymentKey], map: "uk_payment_orders_provider_payment_key")
  @@index([companyId, createdAt], map: "idx_payment_orders_company_created")
  @@index([candidateId, createdAt], map: "idx_payment_orders_candidate_created")
  @@index([status, createdAt], map: "idx_payment_orders_status_created")
  @@map("payment_orders")
}
