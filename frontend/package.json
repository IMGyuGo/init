{
  "name": "final-weapon-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x",
    "npm": ">=10"
  },
  "scripts": {
    "pretest": "npm run test:candidate-profile",
    "dev": "next dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "audit:avatar-assets": "node ../scripts/audit-interviewer-avatar-assets.mjs",
    "test:candidate-avatar": "tsx src/features/candidate-application-interview/LipSyncDriver.spec.ts && tsx src/features/candidate-application-interview/CubismMouthOpacity.spec.ts && tsx src/features/candidate-application-interview/LocalInterviewerAvatar.spec.tsx && tsx src/features/candidate-application-interview/LocalInterviewerAvatarCss.spec.ts && tsx src/features/candidate-application-interview/InterviewerRiggingPreview.spec.tsx && tsx src/features/candidate-application-interview/CubismSdkRuntime.spec.ts && node ../scripts/audit-interviewer-avatar-assets.spec.mjs && node ../scripts/audit-coherent-mouth-source.spec.mjs && node ../scripts/build-cubism-v6-export.spec.mjs && node ../scripts/audit-cubism-mouth-rig.spec.mjs",
    "test": "npm run typecheck && npm run test:candidate-job-sort && npm run test:candidate-nonverbal && npm run test:route-policy && npm run test:signup-payload && npm run test:ai-job-polling && npm run test:ai-performance && npm run test:apply-set-override && npm run test:posting-draft-keywords",
    "test:candidate-job-sort": "tsx src/features/candidate-application-interview/candidate-job-sort.spec.ts",
    "test:posting-draft-keywords": "tsx src/features/company-recruiting/posting-draft-keywords.spec.ts",
    "test:route-policy": "tsc -p src/features/auth/tsconfig.route-policy-spec.json && node .next/tests/auth-route-policy/features/auth/routePolicy.spec.js",
    "test:signup-payload": "tsc -p src/features/auth/tsconfig.spec.json && node .next/tests/auth/signup-payload.spec.js",
    "test:ai-job-polling": "tsc -p src/features/company-interview-criteria/tsconfig.spec.json && node .next/tests/company-interview-criteria/ai-job-polling.spec.js",
    "test:ai-performance": "tsc -p src/features/ai-performance/tsconfig.spec.json && node .next/tests/ai-performance/client-next-step.spec.js",
    "test:apply-set-override": "tsc -p src/features/candidate-application-interview/tsconfig.apply-set-spec.json && node .next/tests/candidate-apply-set/features/candidate-application-interview/apply-set-override.spec.js",
    "test:candidate-profile": "tsc -p src/features/candidate-application-interview/tsconfig.candidate-profile-spec.json && node .next/tests/candidate-profile/features/candidate-application-interview/candidate-profile-form.spec.js",
    "test:candidate-nonverbal": "tsx src/features/candidate-application-interview/nonverbal-analysis.spec.ts",
    "build": "next build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@tiptap/extension-color": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-text-align": "^3.27.1",
    "@tiptap/extension-text-style": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "ag-psd": "^31.0.2",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
