server() {
  local script_dir action target
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  action="${1:-ui}"
  target="${2:-all}"

  normalize_target() {
    case "${1,,}" in
      all|"") echo "All" ;;
      i|infra|docker|db) echo "Infra" ;;
      a|api|back|backend|be) echo "Api" ;;
      f|front|frontend|fe|web) echo "Frontend" ;;
      w|worker|ai) echo "Worker" ;;
      p|prisma) echo "Prisma" ;;
      *) echo "Unknown target: $1" >&2; return 1 ;;
    esac
  }

  prisma_run() {
    local prisma_action="${1:-menu}"
    local env_file="$script_dir/.env"
    if [[ ! -f "$env_file" ]]; then
      env_file="$script_dir/.env.example"
    fi

    case "${prisma_action,,}" in
      g|generate|client)
        (set -a; [[ -f "$env_file" ]] && source "$env_file"; set +a; cd "$script_dir/backend/api" && npm run prisma:generate)
        ;;
      m|migrate|migration)
        (set -a; [[ -f "$env_file" ]] && source "$env_file"; set +a; cd "$script_dir/backend/api" && npm run db:migrate)
        ;;
      s|seed)
        (set -a; [[ -f "$env_file" ]] && source "$env_file"; set +a; cd "$script_dir/backend/api" && npm run db:seed)
        ;;
      *)
        echo "Usage: server prisma generate|migrate|seed"
        ;;
    esac
  }

  case "${action,,}" in
    ui|menu|tui|server)
      node "$script_dir/scripts/local-dev-menu.mjs"
      ;;
    help|h|-h|--help)
      cat <<'EOF'
Usage:
  server                 # open keyboard menu
  server up              # start all
  server frontend        # start frontend
  server api             # start API
  server worker          # start worker
  server infra           # start Docker infra
  server down            # stop all
  server down api        # stop API
  server prisma          # show prisma command help
  server prisma generate # generate Prisma Client
  server prisma migrate  # run Prisma migrate dev
  server prisma seed     # run Prisma seed

Short targets:
  all, a/api, f/frontend, w/worker, i/infra, p/prisma
EOF
      ;;
    p|prisma)
      prisma_run "$target"
      ;;
    up|start|on|s)
      target="$(normalize_target "$target")" || return 1
      if [[ "$target" == "Prisma" ]]; then
        prisma_run
      else
        bash "$script_dir/start-local.sh" "$target"
      fi
      ;;
    down|stop|off|x)
      target="$(normalize_target "$target")" || return 1
      if [[ "$target" == "Prisma" ]]; then
        echo "[local] Prisma is a one-shot command and has no process to stop."
      else
        bash "$script_dir/stop-local.sh" "$target"
      fi
      ;;
    *)
      target="$(normalize_target "$action")" || return 1
      if [[ "$target" == "Prisma" ]]; then
        prisma_run "$target"
      else
        bash "$script_dir/start-local.sh" "$target"
      fi
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  server "$@"
fi
